# Auto detect text files and perform LF normalization
* text=auto

# Bash and Python scripts must check out with LF even on Windows
# (autocrlf=true would give them CRLF, which breaks them under Git Bash)
*.sh text eol=lf
*.py text eol=lf

# Extension-less stub CLIs are bash scripts too
tests/stubs/* text eol=lf
